# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git, so your keys never reach GitHub. Never share it or paste keys in chat.

# Supabase -> Project Settings -> Data API (Project URL)
SUPABASE_URL=https://ivvzjyxakcppvzknizma.supabase.co

# Supabase -> Project Settings -> API Keys -> the SECRET key (service_role / "sb_secret_...").
# Backend only. It bypasses all security rules, so it must never go into the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Project Settings -> API Keys -> the PUBLIC key (anon / "sb_publishable_...").
# Not used yet. Needed later for real login in the browser.
SUPABASE_ANON_KEY=

# Claude API key from console.anthropic.com. Not used yet (AI explanations come later).
ANTHROPIC_API_KEY=

# Websites allowed to call this API (comma-separated). The frontend preview runs on port 8765.
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
